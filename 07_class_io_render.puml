@startuml 07_class_io_render
!include _style.puml
title Rendering, file formats, persistence, import and export - crates ascii_render and ascii_io

package "ascii_render" {

  interface GlyphSource <<trait, Send + Sync>> {
    + font_name() -> &str
    + cell_size() -> (u8, u8)
    + contains(ch: char) -> bool
    + mask(ch: char) -> Arc<GlyphMask>
  }

  class GlyphMask <<struct>> {
    + width: u8
    + height: u8
    + alpha: Vec<u8>
  }

  class TtfGlyphSource <<struct>> {
    - font: fontdue::Font
    - name: String
    - cell_w: u8
    - cell_h: u8
    - baseline: i32
    - cache: RwLock<HashMap<char, Arc<GlyphMask>>>
    + {static} DEFAULT_FONT_PATH: &str = "assets/fonts/default.ttf"
    + load_default(cell_w: u8, cell_h: u8) -> Result<TtfGlyphSource, FontError>
    + from_bytes(bytes: &[u8], name: &str, cell_w: u8, cell_h: u8) -> Result<TtfGlyphSource, FontError>
  }

  class RgbaBuffer <<struct>> {
    + width: u32
    + height: u32
    + pixels: Vec<u8>
  }

  class FrameRasterizer <<utility>> {
    + {static} render(flat: &FlatFrame, canvas: &CanvasSpec, glyphs: &dyn GlyphSource) -> RgbaBuffer
  }

  class ThumbnailBuilder <<utility>> {
    + {static} build(flat: &FlatFrame) -> RgbaBuffer
  }
}

package "ascii_io::format" {

  enum FileKind <<enum>> {
    Ascii
    Aanim
    Aspr
    + magic() -> [u8; 4]
    + extension() -> &str
  }

  class ContainerHeader <<struct>> {
    + magic: [u8; 4]
    + version: u16
    + flags: u16
    + uncompressed_len: u32
    + stored_len: u32
    + crc32: u32
  }

  class ContainerCodec <<utility>> {
    + {static} wrap(kind: FileKind, payload: &[u8]) -> Result<Vec<u8>, FormatError>
    + {static} unwrap(kind: FileKind, bytes: &[u8]) -> Result<Vec<u8>, FormatError>
  }

  class FlatFrameBlockCodec <<utility>> {
    + {static} write(out: &mut Vec<u8>, flat: &FlatFrame)
    + {static} read(r: &mut ByteReader, canvas: &CanvasSpec) -> Result<FlatFrame, FormatError>
  }

  class LayeredFrameBlockCodec <<utility>> {
    + {static} write(out: &mut Vec<u8>, frame: &Frame)
    + {static} read(r: &mut ByteReader, canvas: &CanvasSpec, id: FrameId) -> Result<Frame, FormatError>
  }

  class ByteReader <<struct>> {
    - data: &[u8]
    - pos: usize
    + u8() -> Result<u8, FormatError>
    + u16() -> Result<u16, FormatError>
    + u32() -> Result<u32, FormatError>
    + i64() -> Result<i64, FormatError>
    + string() -> Result<String, FormatError>
    + bytes(n: usize) -> Result<&[u8], FormatError>
    + remaining() -> usize
  }

  interface FormatCodec<T> <<trait>> {
    + kind() -> FileKind
    + encode(value: &T) -> Result<Vec<u8>, FormatError>
    + decode(bytes: &[u8]) -> Result<T, FormatError>
  }

  class AsciiImage <<struct>> {
    + canvas: CanvasSpec
    + font_name: String
    + frame: FlatFrame
  }

  class AsciiAnimation <<struct>> {
    + canvas: CanvasSpec
    + font_name: String
    + fps: Fps
    + looping: bool
    + frames: Vec<FlatFrame>
  }

  class AsciiCodec <<struct>>
  class AanimCodec <<struct>>
  class AsprCodec <<struct>>

  enum FormatError <<enum>> {
    Truncated
    BadMagic
    UnsupportedVersion(found: u16)
    ReservedFlags(flags: u16)
    CrcMismatch
    LengthMismatch
    TooLarge
    InvalidField(name: &str, reason: String)
    Compression(String)
  }
}

package "ascii_io::storage" {

  class ProjectRepository <<struct>> {
    + load(path: &Path) -> Result<Project, RepoError>
    + save(path: &Path, project: &Project) -> Result<(), RepoError>
    + exists(path: &Path) -> bool
  }

  class AtomicWriter <<utility>> {
    + {static} write(path: &Path, bytes: &[u8]) -> io::Result<()>
  }

  class RecentStore <<struct>> {
    - file: PathBuf
    - entries: Vec<RecentEntry>
    + {static} MAX_ENTRIES: usize = 10
    + open_default() -> RecentStore
    + entries() -> &[RecentEntry]
    + touch(path: PathBuf, name: String, now: i64)
    + remove(path: &Path)
    + clear()
    - persist()
  }

  class RecentEntry <<struct, Serialize, Deserialize>> {
    + name: String
    + path: PathBuf
    + last_opened_unix: i64
  }

  enum RepoError <<enum>> {
    Io(io::Error)
    Format(FormatError)
    NotFound
  }

  class BrushStore <<struct>> {
    - file: PathBuf
    - library: BrushLibrary
    + open_default() -> BrushStore
    + library() -> &BrushLibrary
    + upsert(b: Brush) -> Result<BrushId, BrushStoreError>
    + remove(id: BrushId) -> Result<(), BrushStoreError>
    - persist() -> io::Result<()>
  }

  class BrushRecord <<struct, Serialize, Deserialize>> {
    + id: u32
    + name: String
    + width: u8
    + height: u8
    + anchor: (u8, u8)
    + cells: Vec<Option<String>>
  }

  enum BrushStoreError <<enum>> {
    Brush(BrushError)
    Io(io::Error)
  }
}

package "ascii_io::import" {

  class ImportService <<struct>> {
    + {static} MAX_FILE_BYTES: u64 = 16 MiB
    + load(path: &Path) -> Result<ImportedFile, ImportError>
  }

  class ImportedFile <<struct>> {
    + kind: ImportKind
    + name: String
    + width: u32
    + height: u32
    + warnings: Vec<String>
    - source: ImportSource
    + to_buffer(ink: Rgba) -> CellBuffer
  }

  enum ImportKind <<enum>> {
    PlainText
    AsciiImage
  }

  enum ImportSource <<enum>> {
    Text(ParsedText)
    Image(AsciiImage)
  }

  class TextImporter <<utility>> {
    + {static} MAX_DIM: u32 = 4096
    + {static} TAB_WIDTH: u32 = 4
    + {static} parse(bytes: &[u8]) -> Result<ParsedText, ImportError>
  }

  class ParsedText <<struct>> {
    + lines: Vec<Vec<char>>
    + width: u32
    + height: u32
    + replaced_invalid: usize
    + expanded_tabs: usize
  }

  enum ImportError <<enum>> {
    Io(io::Error)
    NotFound
    UnsupportedType(ext: String)
    Empty
    TooLarge(max: String)
    Format(FormatError)
  }
}

package "ascii_io::export" {

  class ExportService <<struct>> {
    + export_frame_png(project: &Project, path: &Path, glyphs: &dyn GlyphSource) -> Result<(), ExportError>
    + export_frame_ascii(project: &Project, path: &Path, glyphs: &dyn GlyphSource) -> Result<(), ExportError>
    + export_animation_aanim(project: &Project, path: &Path, glyphs: &dyn GlyphSource) -> Result<(), ExportError>
    + start_ascii_sequence(project: &Project, folder: PathBuf, base: String, glyphs: Arc<dyn GlyphSource>) -> ExportJobHandle
    + start_mp4(project: &Project, path: PathBuf, glyphs: Arc<dyn GlyphSource>, ffmpeg: PathBuf) -> ExportJobHandle
  }

  class ExportJobHandle <<struct>> {
    + rx: Receiver<ExportMessage>
    + cancel: Arc<AtomicBool>
    - join: Option<JoinHandle<()>>
    + request_cancel()
    + poll() -> Vec<ExportMessage>
  }

  enum ExportMessage <<enum>> {
    Progress(done: u32, total: u32)
    Finished(path: PathBuf)
    Failed(ExportError)
    Cancelled
  }

  interface ExportWorker <<trait, Send>> {
    + run(tx: Sender<ExportMessage>, cancel: Arc<AtomicBool>)
  }

  class Mp4Worker <<struct>> {
    - frames: Vec<Frame>
    - canvas: CanvasSpec
    - fps: Fps
    - out: PathBuf
    - ffmpeg: PathBuf
  }

  class AsciiSequenceWorker <<struct>> {
    - frames: Vec<Frame>
    - canvas: CanvasSpec
    - font_name: String
    - folder: PathBuf
    - names: Vec<String>
  }

  class SequenceNamer <<utility>> {
    + {static} names(base: &str, count: usize) -> Vec<String>
  }

  class FfmpegLocator <<utility>> {
    + {static} find() -> Option<PathBuf>
  }

  enum ExportError <<enum>> {
    Io(io::Error)
    Image(String)
    Format(FormatError)
    FfmpegNotFound
    FfmpegFailed(status: i32, stderr_tail: String)
    Cancelled
  }

  class Clock <<trait object>> {
    + now_unix() -> i64
  }
}

class "ffmpeg" as Ffmpeg <<external process>>

