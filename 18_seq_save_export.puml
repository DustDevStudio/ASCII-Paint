@startuml 18a_seq_quick_save
!include _style.puml
title Sequence - Save project (Ctrl+S) to the existing .aspr
autonumber

actor User
participant "EditorScreen" as E
participant "AsciiPaintApp" as App
participant "Clock" as Clk
participant "Project" as P
participant "ProjectRepository" as Repo
participant "AsprCodec +\nAtomicWriter" as Disk
participant "History" as H
participant "ErrorModal" as Err

User -> E : Ctrl+S  (File > Save)
E --> App : AppAction::QuickSave
App -> Clk : now_unix()
App -> P : touch_modified(now)
App -> Repo : save(session.path, &project)
Repo -> Disk : AsprCodec.encode(project)\nAtomicWriter::write(path, bytes)  (tmp file + fsync + rename)
alt Ok
  Disk --> Repo : Ok
  Repo --> App : Ok
  App -> H : mark_clean()
  App -> App : status bar toast "Saved"; window title loses the "*"
  opt pending action exists (close / quit / open another project)
    App -> App : continue the pending action (diagram 09a, SavingBeforeClose)
  end
else Err(e)
  Disk --> Repo : Err
  Repo --> App : Err(RepoError)
  App -> Err : new("Cannot save project", message(e))
  App -> App : modal = Error(Err); history stays dirty; pending action (if any) is kept
end
@enduml

@startuml 18b_seq_save_as_and_export
!include _style.puml
title Sequence - Save as / Export (.aspr, .png, .ascii, .aanim, .mp4) through the Save modal
autonumber

actor User
participant "MenuBar" as MB
participant "AsciiPaintApp" as App
participant "SaveModal" as M
participant "FfmpegLocator" as FL
participant "FileDialogs" as FD
participant "ExportService" as X
participant "ProjectRepository" as Repo
participant "RecentStore" as Recent
participant "ErrorModal" as Err

User -> MB : File > Save as... (or Export...)
MB --> App : AppAction::OpenSaveModal
App -> FL : find()
FL --> App : Option<PathBuf>
App -> M : new(format = ProjectAspr, file_name = project name, folder = parent of session.path,\n ffmpeg_available = is_some)
App -> App : modal = Some(Modal::Save(M)); playback.pause()

loop while open
  User -> M : choose a format in the list  (Project: .aspr | Current frame: .png, .ascii | All frames: .aanim, .mp4)
  M -> M : file_name extension follows the format;\nFramePng/FrameAscii default name = "<project>_frame<NNN>" (NNN = 1-based index of the selected frame, 3 digits)
  opt User clicks "Browse..."
    M -> FD : pick_folder(start = folder)
    FD --> M : Option<PathBuf>
  end
  M -> M : validate(): folder exists, file_name valid, format enabled\n(AnimationMp4 is disabled without ffmpeg)
end

alt Cancel / Esc
  M --> App : Cancelled
  App -> App : modal = None
else Save
  User -> M : click Save
  M --> App : Accepted(AppAction::SaveAs(SaveRequest{ format, path }))
  alt format = ProjectAspr
    App -> Repo : save(path, &project)   (touch_modified first)
    Repo --> App : Ok
    App -> App : session.path = path; history.mark_clean()
    App -> Recent : touch(path, project.meta.name, now)
  else format = FramePng
    App -> X : export_frame_png(&project, path, glyphs)
    note right of X : renders ONLY the selected frame with ITS OWN background colour;\n1920 x 1080 RGBA8 for the default canvas
  else format = FrameAscii
    App -> X : export_frame_ascii(&project, path, glyphs)
  else format = AnimationAanim
    App -> X : export_animation_aanim(&project, path, glyphs)
    note right of X : all frames in timeline order + fps + loop flag
  else format = AnimationMp4
    App -> FL : find()
    alt None
      App -> Err : new("ffmpeg not found", ...)
      App -> App : modal = Error(Err)
    else Some(ffmpeg)
      App -> X : start_mp4(&project, path, glyphs, ffmpeg)
      X --> App : ExportJobHandle
      App -> App : export_job = Some(handle); modal = ExportProgress(done 0 / total N)\n(continues in diagram 18c)
    end
  end
  alt synchronous format finished
    X --> App : Ok  (or Repo Ok)
    App -> App : modal = None; toast "Saved <file name>"
    note right of App : Exports (.png .ascii .aanim .mp4) never change session.path or the dirty state.\nOnly .aspr does.
  else error
    X --> App : Err(ExportError / RepoError)
    App -> Err : new("Cannot save", message)
    App -> App : modal = Error(Err)   (the Save modal is closed; user can reopen it)
  end
end
@enduml

@startuml 18c_seq_export_mp4
!include _style.puml
title Sequence - Export all frames to .mp4 (worker thread, progress and cancel)
autonumber

actor User
participant "AsciiPaintApp" as App
participant "ExportProgressModal" as M
participant "ExportJobHandle" as Job
participant "Mp4Worker\n(thread)" as W
participant "FrameRasterizer" as FR
participant "ffmpeg\n(process)" as FF
participant "Filesystem" as FS

App -> Job : (created by ExportService::start_mp4: channel, cancel flag, thread)
Job -> W : spawn thread: run(tx, cancel)  with a CLONE of all frames, canvas, fps
W -> FF : spawn ffmpeg (rawvideo rgba, W x H, framerate fps, libx264, yuv420p, -f mp4 out.mp4.part)
W -> W : start stderr drain thread (keeps last 4 KiB)

loop for i in 0 .. total
  W -> W : if cancel flag is set -> goto Cancel
  W -> FR : render(frames[i], canvas, glyphs)
  FR --> W : RgbaBuffer  (frame background + cell backgrounds + glyphs)
  W -> FF : stdin.write_all(pixels)
  W --> Job : ExportMessage::Progress(i + 1, total)  (mpsc channel)
end

loop every egui frame
  App -> Job : poll()
  Job --> App : Vec<ExportMessage>
  App -> M : done = i + 1 (latest Progress)   (progress bar and "Frame i / N")
end

alt User clicks Cancel
  User -> M : click Cancel
  M --> App : Accepted(AppAction::CancelExport)
  App -> Job : request_cancel()   (cancel.store(true)); M.cancelling = true
  W -> FF : kill()
  W -> FS : delete out.mp4.part
  W --> Job : ExportMessage::Cancelled
  App -> App : export_job = None; modal = None
else all frames written
  W -> FF : drop(stdin)  (EOF)
  W -> FF : wait()
  alt exit status == 0
    W -> FS : rename(out.mp4.part -> out.mp4)
    W --> Job : ExportMessage::Finished(path)
    App -> App : export_job = None; modal = None; toast "Exported <file name>"
  else exit status != 0
    W -> FS : delete out.mp4.part
    W --> Job : ExportMessage::Failed(FfmpegFailed(code, stderr_tail))
    App -> App : export_job = None; modal = ErrorModal("MP4 export failed", stderr_tail)
  end
else pipe error (ffmpeg crashed)
  W -> FF : kill()
  W -> FS : delete out.mp4.part
  W --> Job : ExportMessage::Failed(Io)
end
note over W
  The editor stays interactive in principle, but the modal blocks input until the job ends.
  Window close during an export: AsciiPaintApp.on_close_requested() sets the cancel flag, joins the worker (which deletes the .part file)
  and then lets the window close. No confirmation dialog is shown for this case.
end note
@enduml
