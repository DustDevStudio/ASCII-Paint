@startuml 04_class_tools
!include _style.puml
title Tools, selection and shape algorithms - crate ascii_core::{tools, selection, algo}

package "ascii_core::selection" {
  enum SelectionMode <<enum>> {
    Replace
    Add
    Subtract
  }

  class Selection <<struct>> {
    - cols: u16
    - rows: u16
    - bits: Vec<u64>
    - count: usize
    - revision: u64
    + new(spec: &CanvasSpec) -> Selection
    + is_empty() -> bool
    + count() -> usize
    + contains(c: CellCoord) -> bool
    + permits(c: CellCoord) -> bool
    + bounds() -> Option<CellRect>
    + apply(cells: &[CellCoord], mode: SelectionMode)
    + select_all()
    + clear()
    + boundary_edges() -> Vec<EdgeSegment>
    + revision() -> u64
  }

  class EdgeSegment <<struct, Copy>> {
    + from: (u16, u16)
    + to: (u16, u16)
  }
}

package "ascii_core::algo" {
  class ShapeRasterizer <<utility, no state>> {
    + {static} rect(a: CellCoord, b: CellCoord, spec: &CanvasSpec) -> Vec<CellCoord>
    + {static} ellipse(a: CellCoord, b: CellCoord, spec: &CanvasSpec) -> Vec<CellCoord>
    + {static} polygon(vertices: &[CellCoord], spec: &CanvasSpec) -> Vec<CellCoord>
    + {static} line(a: CellCoord, b: CellCoord) -> Vec<CellCoord>
  }

  class FloodFill <<utility, no state>> {
    + {static} region(grid: &Grid, seed: CellCoord, channel: PaintChannel, limit: &Selection) -> Vec<CellCoord>
  }
}

package "ascii_core::tools" {

  enum ToolId <<enum>> {
    EditCell
    ClearCell
    PaintCell
    FillCell
    SelectRect
    SelectPolygon
    SelectEllipse
  }

  enum PaintChannel <<enum>> {
    Foreground
    Background
  }

  class Brush <<struct, Clone>> {
    + paint: Rgb
    + erase: Option<Rgb>
    + channel: PaintChannel
    + {static} default() -> Brush
  }

  class Modifiers <<struct, Copy>> {
    + shift: bool
    + alt: bool
    + ctrl: bool
    + selection_mode() -> SelectionMode
  }

  enum ToolEvent <<enum>> {
    Activate
    Deactivate
    PointerDown(cell: CellCoord, mods: Modifiers)
    PointerMove(cell: Option<CellCoord>, mods: Modifiers)
    PointerUp(cell: Option<CellCoord>, mods: Modifiers)
    DoubleClick(cell: CellCoord, mods: Modifiers)
    Key(key: ToolKey, mods: Modifiers)
    Text(ch: char)
    Cancel
  }

  enum ToolKey <<enum>> {
    ArrowUp
    ArrowDown
    ArrowLeft
    ArrowRight
    Enter
    Backspace
    Delete
    Escape
  }

  enum ToolResponse <<enum>> {
    Consumed
    Ignored
  }

  class ToolContext <<struct, borrowed>> {
    + project: &mut Project
    + selection: &mut Selection
    + brush: &Brush
    + history: &mut History
  }

  interface Tool <<trait>> {
    + id() -> ToolId
    + display_name() -> &str
    + on_event(ev: ToolEvent, ctx: &mut ToolContext) -> ToolResponse
    + overlay() -> ToolOverlay
    + is_busy() -> bool
  }

  enum ToolOverlay <<enum>> {
    None
    TextCursor(cell: CellCoord)
    RectPreview(rect: CellRect, mode: SelectionMode)
    EllipsePreview(rect: CellRect, mode: SelectionMode)
    PolygonPreview(vertices: Vec<CellCoord>, hover: Option<CellCoord>, mode: SelectionMode)
  }

  class ToolRegistry <<struct>> {
    - tools: Vec<Box<dyn Tool>>
    - active: ToolId
    + new() -> ToolRegistry
    + active_id() -> ToolId
    + active() -> &dyn Tool
    + switch_to(id: ToolId, ctx: &mut ToolContext)
    + dispatch(ev: ToolEvent, ctx: &mut ToolContext) -> ToolResponse
  }

  class PatchBuilder <<struct>> {
    - frame_id: FrameId
    - order: Vec<CellCoord>
    - before: HashMap<CellCoord, Cell>
    - after: HashMap<CellCoord, Cell>
    + new(frame_id: FrameId) -> PatchBuilder
    + write(project: &mut Project, c: CellCoord, new: Cell) -> bool
    + is_empty() -> bool
    + finish(label: &str) -> Option<CellPatchCommand>
  }

  interface CellOperation <<trait>> {
    + label() -> &str
    + apply(old: Cell, brush: &Brush) -> Cell
  }

  class ClearOperation <<struct>>
  class PaintOperation <<struct>>

  class "StrokeTool<O: CellOperation>" as StrokeTool <<struct>> {
    - op: O
    - stroke: Option<StrokeState>
  }

  class StrokeState <<struct>> {
    + last: CellCoord
    + builder: PatchBuilder
  }

  class ClearCellTool <<type alias>>
  class PaintCellTool <<type alias>>

  class EditCellTool <<struct>> {
    - cursor: Option<CellCoord>
    - anchor_col: u16
    - session: Option<PatchBuilder>
  }

  class FillCellTool <<struct>>

  interface DragShape <<trait>> {
    + label() -> &str
    + rasterize(a: CellCoord, b: CellCoord, spec: &CanvasSpec) -> Vec<CellCoord>
  }

  class RectShape <<struct>>
  class EllipseShape <<struct>>

  class "ShapeSelectTool<S: DragShape>" as ShapeSelectTool <<struct>> {
    - shape: S
    - drag: Option<DragState>
  }

  class DragState <<struct>> {
    + anchor: CellCoord
    + current: CellCoord
    + mode: SelectionMode
  }

  class SelectRectTool <<type alias>>
  class SelectEllipseTool <<type alias>>

  class SelectPolygonTool <<struct>> {
    - vertices: Vec<CellCoord>
    - hover: Option<CellCoord>
    - mode: SelectionMode
  }
}

' ---- relationships ----
Tool <|.. EditCellTool
Tool <|.. FillCellTool
Tool <|.. StrokeTool
Tool <|.. ShapeSelectTool
Tool <|.. SelectPolygonTool

CellOperation <|.. ClearOperation
CellOperation <|.. PaintOperation
StrokeTool o-- "1" CellOperation : op
StrokeTool *-- "0..1" StrokeState
StrokeState *-- "1" PatchBuilder
EditCellTool *-- "0..1" PatchBuilder : typing session
ClearCellTool ..> StrokeTool : <<bind>> O -> ClearOperation
PaintCellTool ..> StrokeTool : <<bind>> O -> PaintOperation

DragShape <|.. RectShape
DragShape <|.. EllipseShape
ShapeSelectTool o-- "1" DragShape : shape
ShapeSelectTool *-- "0..1" DragState
SelectRectTool ..> ShapeSelectTool : <<bind>> S -> RectShape
SelectEllipseTool ..> ShapeSelectTool : <<bind>> S -> EllipseShape

ToolRegistry *-- "7" Tool : tools
ToolRegistry --> ToolId : active
Tool ..> ToolEvent : consumes
Tool ..> ToolOverlay : produces
Tool ..> ToolContext : uses
Tool ..> ToolResponse
ToolEvent ..> ToolKey
ToolEvent ..> Modifiers
ToolContext o-- Brush
ToolContext o-- Selection
Brush *-- PaintChannel

ShapeSelectTool ..> ShapeRasterizer
SelectPolygonTool ..> ShapeRasterizer
StrokeTool ..> ShapeRasterizer : line()
RectShape ..> ShapeRasterizer
EllipseShape ..> ShapeRasterizer
FillCellTool ..> FloodFill
FloodFill ..> Selection : limit
Selection ..> SelectionMode
Selection ..> EdgeSegment : boundary_edges()
Modifiers ..> SelectionMode : shift=Add, alt=Subtract, else Replace

note as N1
  is_busy() per tool (true = something is in progress that Cancel would commit or discard)
  EditCellTool: session has uncommitted changes | StrokeTool: stroke is Some | ShapeSelectTool: drag is Some
  SelectPolygonTool: vertices is not empty | FillCellTool: always false
  overlay() is a pure read (called every egui frame while painting); it never mutates the tool.
end note

note as N2
  Selection semantics
  - Not part of the project file and NOT in undo history. Persists across frame switches.
  - permits(c) = is_empty() || contains(c).  EVERY drawing tool must call permits() before writing a cell,
    so with an active selection the edits are clipped to it; with no selection the whole page is editable.
  - apply(cells, Replace)  : clear(), then insert all.   apply(cells, Add): insert all.
    apply(cells, Subtract) : remove all.
  - Every mutation bumps revision; the canvas caches boundary_edges() per revision.
  - Keyboard (handled by EditorScreen, not by a tool): Ctrl+A = select_all(), Ctrl+D / Esc (no tool busy) = clear(),
    Delete (no EditCell session) = clear every selected cell of the current frame via ClearOperation as ONE command.
end note

note as N3
  Event routing rule (CanvasView -> ToolRegistry.dispatch)
  - Pointer position is converted to a cell with floor(). If it is outside the page:
      * PointerDown outside the page is dropped (tool never sees it).
      * PointerMove / PointerUp outside the page send cell = None; tools then use the LAST valid cell
        (stroke tools skip the segment, shape tools clamp via CanvasSpec::clamp).
  - Only the primary (left) button reaches tools. Middle button / Space+drag = pan (see ViewportController).
  - While playback is Playing the CanvasView sends NO tool events.
  - Switching tool = ToolRegistry.switch_to(): old.on_event(Deactivate) then new.on_event(Activate).
  - Deactivate / Cancel semantics: StrokeTool commits what was painted so far; EditCellTool commits its typing session;
    ShapeSelectTool and SelectPolygonTool discard the preview (selection unchanged).
end note

note as N4
  write(project, c, new)
  1. frame = project.timeline.selected_frame_mut()
  2. old = frame.grid.get(c); if old == new -> return false (no-op, nothing recorded)
  3. first time c is touched: before[c] = old (never overwritten later)
  4. frame.set_cell(c, new); after[c] = new; push c to `order` once
  5. return true
  The cell is changed IMMEDIATELY (live feedback); history only receives the command at finish().
  finish(label): drop cells where before[c] == after[c]; if none left -> None;
  else Some(CellPatchCommand { frame_id, changes in `order`, label }).
  The tool then calls history.record_applied(cmd) - it does NOT apply again.
end note

note as N5
  Stroke rules (Clear cell / Paint cell)
  - PointerDown(c): start StrokeState{ last = c, builder }, then paint cell c only if selection.permits(c).
    (Permission is checked per cell, so a stroke may cross in and out of the selection.)
  - PointerMove(Some(c)) while a stroke is active: for every cell k in ShapeRasterizer::line(last, c)
    (excluding `last`, including c) call write(k, op.apply(old, brush)) if selection.permits(k).
    Then last = c. This guarantees no gaps on fast mouse moves.
  - PointerMove(None): keep stroke alive, do not change `last`.
  - PointerUp / Deactivate / Cancel: finish(op.label()) -> history.record_applied(cmd); stroke = None.
    One drag = ONE undo step.
end note

note as N6
  apply(old, brush) = Cell { glyph: ' ', fg: Rgb::WHITE, bg: brush.erase }
  brush.erase == None  -> cell becomes fully transparent (frame background shows through).
  label() = "Clear cells"
end note

note as N7
  apply(old, brush):
    channel == Foreground -> Cell { fg: brush.paint, ..old }          (glyph and bg untouched)
    channel == Background -> Cell { bg: Some(brush.paint), ..old }    (glyph and fg untouched)
  label() = "Paint cells"
end note

note as N8
  Edit cell rules (text cursor)
  - PointerDown(c): if !selection.permits(c) ignore. Else commit current session, cursor = Some(c), anchor_col = c.col.
  - Text(ch) (printable, not control): requires cursor. write(cursor, Cell { glyph: ch, fg: brush.paint, bg: old.bg }).
      Then cursor.col = min(cursor.col + 1, cols - 1). The cursor never wraps to the next row.
      If the new cursor cell is not permitted by the selection the cursor stays where it was.
  - Key(Enter)    : cursor = (min(anchor_col, cols-1), min(row + 1, rows - 1)).
  - Key(Backspace): if cursor.col > 0 { cursor.col -= 1 }; write(cursor, Cell { glyph: ' ', ..old }).
  - Key(Delete)   : write(cursor, Cell { glyph: ' ', ..old }); cursor does not move.
  - Key(Arrow*)   : commit session, then move cursor by one cell clamped to the page; anchor_col = new col for Left/Right.
  - Key(Escape) / Cancel / Deactivate / PointerDown elsewhere: commit session (finish("Edit text")), cursor = None.
  - One typing session (click ... until a commit trigger above) = ONE undo step.
end note

note as N9
  Fill cell rules
  - PointerDown(c): if selection is non-empty and !selection.contains(c) -> ignore.
  - target colour = brush.paint (Foreground channel sets fg, Background channel sets bg = Some(paint)).
  - cells = FloodFill::region(grid, c, brush.channel, &selection)   (see activity diagram 19)
  - if cells is empty -> nothing. Else write all of them through ONE PatchBuilder, label "Fill cells".
  - If the seed cell already has the paint colour in that channel the region is empty (no-op).
end note

note as N10
  Rect / Ellipse select rules
  - PointerDown(c): drag = DragState{ anchor: c, current: c, mode: mods.selection_mode() }.
  - PointerMove(Some(c)): drag.current = c.  PointerMove(None): drag.current = clamp(last pointer position).
  - overlay(): RectPreview / EllipsePreview of CellRect::from_corners(anchor, current) (nothing is selected yet).
  - PointerUp: cells = shape.rasterize(anchor, current); selection.apply(cells, drag.mode); drag = None.
    A click without moving selects the single cell under the cursor (a 1x1 rectangle / ellipse).
  - Cancel / Escape during drag: drag = None, selection unchanged.
end note

note as N11
  Polygon select rules
  - PointerDown(c): if vertices is empty, mode = mods.selection_mode(). If c equals the LAST vertex ignore it
      (this also absorbs the 2nd click of a double-click). If c equals vertices[0]: close() when vertices.len() >= 3,
      otherwise ignore it. Otherwise push c.
  - PointerMove(Some(c)): hover = Some(c) (rubber-band edge preview).
  - DoubleClick / Key(Enter): close().
  - Key(Backspace): pop last vertex; if empty the tool is idle again.
  - Key(Escape) / Cancel / Deactivate: vertices.clear() (selection unchanged).
  - close(): if vertices.len() < 3 -> discard and clear. Else
      cells = ShapeRasterizer::polygon(vertices); selection.apply(cells, mode); vertices.clear().
end note


