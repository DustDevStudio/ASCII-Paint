@startuml 04_class_tools
!include _style.puml
title Tools, brushes, selection and algorithms - crate ascii_core::{tools, brush, selection, algo}

package "ascii_core::selection" {
  enum SelectionMode <<enum>> {
    Replace
    Add
    Subtract
  }

  class Selection <<struct, Clone>> {
    - cols: u16
    - rows: u16
    - bits: Vec<u64>
    - count: usize
    - revision: u64
    + new(spec: &CanvasSpec) -> Selection
    + is_empty() -> bool
    + count() -> usize
    + contains(c: CellCoord) -> bool
    + permits(c: CellCoord) -> bool
    + bounds() -> Option<CellRect>
    + cells() -> Vec<CellCoord>
    + apply(cells: &[CellCoord], mode: SelectionMode)
    + select_all()
    + clear()
    + invert()
    + translate(dx: i32, dy: i32) -> bool
    + restore(other: &Selection)
    + resize(spec: &CanvasSpec)
    + boundary_edges() -> Vec<EdgeSegment>
    + revision() -> u64
  }

  class EdgeSegment <<struct, Copy>> {
    + from: (u16, u16)
    + to: (u16, u16)
  }
}

package "ascii_core::brush" {
  class BrushId <<struct, Copy, Eq, Hash>> {
    + 0: u32
    + {static} FIRST_CUSTOM: u32 = 1000
    + is_builtin() -> bool
  }

  class Stamp <<struct, Clone, Eq>> {
    + width: u8
    + height: u8
    + anchor: (u8, u8)
    + glyphs: Vec<Option<char>>
    + {static} single(ch: char) -> Stamp
    + glyph_at(x: u8, y: u8) -> Option<char>
    + cells() -> impl Iterator<Item = (i8, i8, char)>
    + fill_glyph() -> char
  }

  class Brush <<struct, Clone>> {
    + id: BrushId
    + name: String
    + stamp: Stamp
    + is_builtin() -> bool
    + validate() -> Result<(), BrushError>
  }

  class BrushLibrary <<struct, Clone>> {
    - brushes: Vec<Brush>
    - next_custom: u32
    + {static} with_builtins() -> BrushLibrary
    + all() -> &[Brush]
    + get(id: BrushId) -> Option< &Brush>
    + default_id() -> BrushId
    + upsert(b: Brush) -> Result<BrushId, BrushError>
    + remove(id: BrushId) -> Result<(), BrushError>
  }

  enum BrushError <<enum>> {
    InvalidName
    DuplicateName
    BadSize
    EmptyStamp
    AnchorNotOnGlyph
    InvalidGlyph
    BuiltinReadOnly
    NotFound
  }
}

package "ascii_core::algo" {
  class ShapeRasterizer <<utility, no state>> {
    + {static} rect(a: CellCoord, b: CellCoord, spec: &CanvasSpec) -> Vec<CellCoord>
    + {static} ellipse(a: CellCoord, b: CellCoord, spec: &CanvasSpec) -> Vec<CellCoord>
    + {static} polygon(vertices: &[CellCoord], spec: &CanvasSpec) -> Vec<CellCoord>
    + {static} line(a: CellCoord, b: CellCoord) -> Vec<CellCoord>
  }

  class FloodFill <<utility, no state>> {
    + {static} region(layer: &Layer, seed: CellCoord, plane: Plane, limit: &Selection) -> Vec<CellCoord>
  }
}

package "ascii_core::tools" {

  enum ToolId <<enum>> {
    Paint
    Erase
    Fill
    Pick
    SelectRect
    SelectPolygon
    SelectEllipse
    Move
  }

  enum MoveMode <<enum>> {
    Contents
    OutlineOnly
  }

  enum PickSource <<enum>> {
    Merged
    ActiveLayer
  }

  class ToolOptions <<struct, Clone>> {
    + brush: BrushId
    + planes: PlaneSet
    + ink_color: Rgba
    + fill_color: Rgba
    + erase_size: u8
    + selection_mode: SelectionMode
    + move_mode: MoveMode
    + pick_source: PickSource
    + {static} default() -> ToolOptions
    + mode_for(mods: Modifiers) -> SelectionMode
  }

  class Modifiers <<struct, Copy>> {
    + shift: bool
    + alt: bool
    + ctrl: bool
  }

  enum ToolEvent <<enum>> {
    Activate
    Deactivate
    PointerDown(cell: CellCoord, mods: Modifiers)
    PointerMove(cell: Option<CellCoord>, mods: Modifiers)
    PointerUp(cell: Option<CellCoord>, mods: Modifiers)
    DoubleClick(cell: CellCoord, mods: Modifiers)
    Key(key: ToolKey, mods: Modifiers)
    Cancel
  }

  enum ToolKey <<enum>> {
    ArrowUp
    ArrowDown
    ArrowLeft
    ArrowRight
    Enter
    Backspace
    Delete
    Escape
  }

  enum ToolResponse <<enum>> {
    Consumed
    Ignored
    Picked(PickedColors)
  }

  class PickedColors <<struct, Copy>> {
    + ink: Option<Rgba>
    + fill: Option<Rgba>
  }

  class ToolContext <<struct, borrowed>> {
    + project: &mut Project
    + selection: &mut Selection
    + options: &ToolOptions
    + brushes: &BrushLibrary
    + history: &mut History
  }

  class ToolView <<struct, borrowed, read-only>> {
    + options: &ToolOptions
    + brushes: &BrushLibrary
    + selection: &Selection
    + spec: &CanvasSpec
  }

  interface Tool <<trait>> {
    + id() -> ToolId
    + display_name() -> &str
    + on_event(ev: ToolEvent, ctx: &mut ToolContext) -> ToolResponse
    + overlay(view: &ToolView) -> ToolOverlay
    + is_busy() -> bool
  }

  enum ToolOverlay <<enum>> {
    None
    BrushFootprint(cells: Vec<CellCoord>)
    RectPreview(rect: CellRect, mode: SelectionMode)
    EllipsePreview(rect: CellRect, mode: SelectionMode)
    PolygonPreview(vertices: Vec<CellCoord>, hover: Option<CellCoord>, mode: SelectionMode)
    MovePreview(floating: Option<Arc<CellBuffer>>, offset: (i32, i32))
  }

  class ToolRegistry <<struct>> {
    - tools: Vec<Box<dyn Tool>>
    - active: ToolId
    + new() -> ToolRegistry
    + active_id() -> ToolId
    + active() -> &dyn Tool
    + switch_to(id: ToolId, ctx: &mut ToolContext)
    + dispatch(ev: ToolEvent, ctx: &mut ToolContext) -> ToolResponse
  }

  class PatchBuilder <<struct>> {
    - frame_id: FrameId
    - layer_id: LayerId
    - ink_order: Vec<CellCoord>
    - ink_before: HashMap<CellCoord, InkCell>
    - ink_after: HashMap<CellCoord, InkCell>
    - fill_order: Vec<CellCoord>
    - fill_before: HashMap<CellCoord, Rgba>
    - fill_after: HashMap<CellCoord, Rgba>
    + new(frame_id: FrameId, layer_id: LayerId) -> PatchBuilder
    + write_ink(project: &mut Project, c: CellCoord, v: InkCell) -> bool
    + write_fill(project: &mut Project, c: CellCoord, v: Rgba) -> bool
    + clear(project: &mut Project, cells: &[CellCoord])
    + blit(project: &mut Project, buf: &CellBuffer, offset: (i32, i32))
    + is_empty() -> bool
    + finish(label: &str) -> Option<CellPatchCommand>
    + rollback(project: &mut Project)
  }

  interface StrokeOperation <<trait>> {
    + label() -> &str
    + footprint(at: CellCoord, view: &ToolView) -> Vec<CellCoord>
    + stamp(at: CellCoord, ctx: &mut ToolContext, b: &mut PatchBuilder)
  }

  class PaintOperation <<struct>>
  class EraseOperation <<struct>>

  class "StrokeTool<O: StrokeOperation>" as StrokeTool <<struct>> {
    - op: O
    - hover: Option<CellCoord>
    - stroke: Option<StrokeState>
  }

  class StrokeState <<struct>> {
    + last: CellCoord
    + builder: PatchBuilder
  }

  class PaintTool <<type alias>>
  class EraseTool <<type alias>>

  class FillTool <<struct>>

  interface DragShape <<trait>> {
    + label() -> &str
    + rasterize(a: CellCoord, b: CellCoord, spec: &CanvasSpec) -> Vec<CellCoord>
  }

  class RectShape <<struct>>
  class EllipseShape <<struct>>

  class "ShapeSelectTool<S: DragShape>" as ShapeSelectTool <<struct>> {
    - shape: S
    - drag: Option<DragState>
  }

  class DragState <<struct>> {
    + anchor: CellCoord
    + current: CellCoord
    + mode: SelectionMode
  }

  class SelectRectTool <<type alias>>
  class SelectEllipseTool <<type alias>>

  class SelectPolygonTool <<struct>> {
    - vertices: Vec<CellCoord>
    - hover: Option<CellCoord>
    - mode: SelectionMode
  }

  class PickTool <<struct>> {
    - hover: Option<CellCoord>
    - dragging: bool
  }

  class MoveTool <<struct>> {
    - drag: Option<MoveDrag>
  }

  class MoveDrag <<struct>> {
    + anchor: CellCoord
    + offset: (i32, i32)
    + selection_before: Selection
    + floating: Option<Arc<CellBuffer>>
    + builder: Option<PatchBuilder>
  }
}

