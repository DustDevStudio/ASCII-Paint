@startuml 10a_state_edit_cell
!include _style.puml
title Tool state machine - Edit cell  (events = ToolEvent, see 04)

state NoCursor
state Typing {
  Typing : data / cursor: CellCoord, anchor_col: u16, session: Option<PatchBuilder> (created lazily at the first write)
}

[*] --> NoCursor
NoCursor --> Typing : PointerDown(c) [selection.permits(c)]\n/ cursor = c; anchor_col = c.col
NoCursor --> NoCursor : PointerDown(c) [!selection.permits(c)]\n/ ignored
NoCursor --> NoCursor : Text / Key / Delete / Backspace\n/ Ignored (no cursor)

Typing --> Typing : Text(ch) [permits(cursor)]\n/ write Cell{glyph: ch, fg: brush.paint, bg: old.bg};\n   next = (min(col + 1, cols - 1), row); if permits(next) cursor = next
Typing --> Typing : Key(Enter)\n/ cursor = (min(anchor_col, cols-1), min(row + 1, rows - 1))
Typing --> Typing : Key(Backspace)\n/ if col > 0 { col -= 1 }; write Cell{glyph: ' ', ..old}
Typing --> Typing : Key(Delete)\n/ write Cell{glyph: ' ', ..old}; cursor stays
Typing --> Typing : Key(Arrow*)\n/ commit(); cursor = clamp(cursor + delta); anchor_col = cursor.col for Left/Right
Typing --> Typing : PointerDown(c) [permits(c)]\n/ commit(); cursor = c; anchor_col = c.col
Typing --> NoCursor : Key(Escape) | Cancel | Deactivate\n/ commit(); cursor = None

note bottom
  commit() = if session has changes: history.record_applied(session.finish("Edit text")); session = None.
  Typing a character with the cursor on a cell that is outside an active selection is ignored (Text is consumed, nothing written).
  All writes go through PatchBuilder::write (live on the grid, recorded for undo).
end note
@enduml

@startuml 10b_state_stroke_tools
!include _style.puml
title Tool state machine - Clear cell and Paint cell  (StrokeTool<O>, O = ClearOperation | PaintOperation)

state Idle
state Stroking {
  Stroking : data / last: CellCoord, builder: PatchBuilder
}

[*] --> Idle
Idle --> Stroking : PointerDown(c)\n/ builder = new; last = c;\n   if permits(c) write(c, op.apply(old, brush))
Stroking --> Stroking : PointerMove(Some(c))\n/ for k in line(last, c) skipping last: if permits(k) write(k, op.apply(old, brush)); last = c
Stroking --> Stroking : PointerMove(None)\n/ ignored (pointer left the page; last unchanged)
Stroking --> Idle : PointerUp(_)\n/ commit()
Stroking --> Idle : Cancel | Deactivate\n/ commit()
Idle --> Idle : Key / Text\n/ Ignored

note bottom
  commit() = if let Some(cmd) = builder.finish(op.label()) { history.record_applied(cmd) }.
  A stroke that changed nothing (e.g. painting a cell with the colour it already has) records NOTHING.
  One continuous drag = one undo step, even when it crosses many cells.
  Active selection: cells outside the selection are skipped per cell, the stroke itself keeps running.
end note
@enduml

@startuml 10c_state_fill
!include _style.puml
title Tool state machine - Fill cell  (stateless: every click is atomic)

state Idle

[*] --> Idle
Idle --> Idle : PointerDown(c) [selection non-empty and !selection.contains(c)]\n/ ignored
Idle --> Idle : PointerDown(c) [seed already has the paint colour in brush.channel]\n/ nothing to do, nothing recorded
Idle --> Idle : PointerDown(c) [otherwise]\n/ cells = FloodFill::region(grid, c, brush.channel, &selection);\n   one PatchBuilder: Foreground -> Cell{fg: paint, ..old}, Background -> Cell{bg: Some(paint), ..old};\n   history.record_applied(builder.finish("Fill cells"))
Idle --> Idle : PointerMove / PointerUp / Key / Text / Cancel / Deactivate\n/ Ignored

note bottom
  The fill is computed and applied entirely inside the PointerDown handler (4-connected scanline fill, max 17 280 cells).
  There is no preview and no drag behaviour.
end note
@enduml

@startuml 10d_state_shape_select
!include _style.puml
title Tool state machine - Square select and Ellipse select  (ShapeSelectTool<RectShape | EllipseShape>)

state Idle
state Dragging {
  Dragging : data / anchor: CellCoord, current: CellCoord, mode: SelectionMode
  Dragging : overlay / RectPreview or EllipsePreview of CellRect::from_corners(anchor, current)
}

[*] --> Idle
Idle --> Dragging : PointerDown(c, mods)\n/ drag = {anchor: c, current: c, mode: mods.selection_mode()}
Dragging --> Dragging : PointerMove(Some(c))\n/ current = c
Dragging --> Dragging : PointerMove(None)\n/ current = clamp(last known pointer position to the page)
Dragging --> Idle : PointerUp(_)\n/ cells = shape.rasterize(anchor, current, spec);\n   selection.apply(cells, mode)
Dragging --> Idle : Key(Escape) | Cancel | Deactivate\n/ drag = None  (selection unchanged)

note bottom
  mode: no modifier = Replace, Shift = Add, Alt = Subtract. The modifier is read ONCE at PointerDown.
  A click without moving selects the single cell under the pointer (anchor == current -> 1 x 1 shape).
end note
@enduml

@startuml 10e_state_polygon_select
!include _style.puml
title Tool state machine - Polygon select  (SelectPolygonTool)

state Idle
state Building {
  Building : data / vertices: Vec<CellCoord> (n >= 1), hover: Option<CellCoord>, mode: SelectionMode
  Building : overlay / PolygonPreview(vertices, hover, mode): edges between vertices + rubber-band edge to hover
}

[*] --> Idle
Idle --> Building : PointerDown(c, mods)\n/ vertices = [c]; mode = mods.selection_mode()
Building --> Building : PointerDown(c) [c == last vertex]\n/ ignored (absorbs the 2nd click of a double-click)
Building --> Building : PointerDown(c) [c == vertices[0] and n < 3]\n/ ignored
Building --> Building : PointerDown(c) [otherwise, not closing]\n/ vertices.push(c)
Building --> Building : PointerMove(Some(c))\n/ hover = Some(c)
Building --> Building : Key(Backspace) [n > 1]\n/ vertices.pop()
Building --> Idle : Key(Backspace) [n == 1]\n/ vertices.clear()
Building --> Idle : PointerDown(c) [c == vertices[0] and n >= 3]\n/ close()
Building --> Idle : DoubleClick | Key(Enter)\n/ close()
Building --> Idle : Key(Escape) | Cancel | Deactivate\n/ vertices.clear() (selection unchanged)

note bottom
  close(): if n < 3 -> vertices.clear() (nothing selected).
          else cells = ShapeRasterizer::polygon(vertices, spec); selection.apply(cells, mode); vertices.clear().
  The polygon is closed automatically from the last vertex back to the first. Vertices sit at cell CENTRES.
  The selection modifier (Shift / Alt) is read at the FIRST click only.
  is_busy() is true in Building. Undo / redo always send Cancel first, which discards the polygon.
end note
@enduml
