@startuml 15a_seq_frame_operations
!include _style.puml
title Sequence - Frame list operations (add, duplicate, delete, reorder, select, fps)
autonumber

actor User
participant "FramePanel" as FP
participant "EditorSession" as S
participant "Command\n(Add/Delete/Move/SetPlaybackSettings)" as C
participant "History" as H
participant "Timeline" as T
participant "ThumbnailCache" as TC

alt User clicks [+ Add]
  User -> FP : click Add
  FP -> S : add_frame()
  S -> S : playback.pause()
  S -> C : AddFrameCommand::blank_after(project, selected_index)\n(new FrameId; background = background of the selected frame; ONE blank layer "Layer 1")
  S -> H : execute(cmd, project)
  H -> C : apply(project)
  C -> T : insert(selected + 1, frame); select(selected + 1)
else User clicks [Duplicate]
  User -> FP : click Duplicate
  FP -> S : duplicate_frame()
  S -> C : AddFrameCommand::duplicate(project, selected_index)\n(copy of ALL layers AND background, new FrameId)
  S -> H : execute(cmd, project)
  H -> C : apply(project)
  C -> T : insert(selected + 1, copy); select(selected + 1)
else User clicks [Delete]  (disabled when len == 1)
  User -> FP : click Delete
  FP -> S : delete_frame()
  S -> C : DeleteFrameCommand::new(project, selected_index)
  S -> H : execute(cmd, project)
  H -> C : apply(project)
  C -> T : remove(index); select(min(index, len - 1))
else User drags frame i and drops it on slot j
  User -> FP : drag item i  (FrameDrag{ from: i, hover_slot })
  FP -> FP : draws an insertion line at hover_slot while dragging
  User -> FP : release at slot j
  opt j != i
    FP -> S : move_frame(i, to)   (to = j adjusted by -1 when j > i, i.e. index after removal)
    S -> C : MoveFrameCommand{ from: i, to, selected_before }
    S -> H : execute(cmd, project)
    H -> C : apply(project)
    C -> T : move_frame(i, to); select(to)
  end
else User clicks frame i
  User -> FP : click item i
  FP -> S : select_frame(i)
  S -> S : playback.pause()
  S -> T : select(i)   (not undoable, not dirty-making; selection mask is kept)
else User changes FPS or Loop
  User -> FP : commit FPS field (Enter / focus lost / drag released) or toggle Loop
  FP -> S : set_fps(f) / set_looping(b)
  S -> C : SetPlaybackSettingsCommand{ before, after }   (skipped when equal)
  S -> H : execute(cmd, project)
end

... next egui frame ...
FP -> TC : get(ctx, frame) for every visible item
TC -> TC : rebuild only entries whose Frame.revision changed;\nretain_only(current frame ids) drops textures of deleted frames
@enduml

@startuml 15b_seq_frame_background
!include _style.puml
title Sequence - Edit frame background colour
autonumber

actor User
participant "FramePanel" as FP
participant "AsciiPaintApp" as App
participant "ColorPickerModal" as M
participant "EditorSession" as S
participant "History" as H
participant "Frame(s)" as F
participant "CanvasRenderer /\nThumbnailCache" as R

User -> FP : click the "Background" swatch of the selected frame
FP --> App : AppAction::OpenColorPicker(ColorPickTarget::FrameBackground(frame_id))
App -> S : playback.pause()
App -> M : new(target, original = Rgba::opaque(frame.background), allow_alpha = false, apply_to_all = false)
App -> App : modal = Some(Modal::ColorPicker(M))

loop while open
  User -> M : drag RGB sliders / type #RRGGBB / click a preset swatch
  M -> M : working = colour   (hex field validated live; invalid text keeps the old colour and shows a red border)
  opt User ticks "Apply to all frames"
    User -> M : toggle checkbox
    M -> M : apply_to_all = true
  end
end

alt User clicks Cancel or presses Esc
  M --> App : ModalOutcome::Cancelled
  App -> App : modal = None   (no command, project untouched)
else User clicks OK
  M --> App : Accepted(AppAction::ApplyColor(FrameBackground(frame_id), Rgba::opaque(rgb), apply_to_all))
  App -> S : set_frame_background(frame_id, rgb, apply_to_all)
  alt apply_to_all == false
    S -> S : cmd = SetFrameBackgroundCommand::new(project, frame_id, rgb)
    note right of S : returns None when the colour is unchanged -> nothing recorded
  else apply_to_all == true
    S -> S : cmd = CompositeCommand("Set background (all frames)")\nwith one SetFrameBackgroundCommand per frame whose colour differs
  end
  opt cmd is Some
    S -> H : execute(cmd, project)
    H -> F : apply(): frame.set_background(rgb) for each target frame  (revision += 1)
  end
  App -> App : modal = None
end

... next egui frame ...
R -> F : CanvasRenderer fills the PAGE rectangle with selected_frame().background
R -> F : ThumbnailCache sees the new revision -> rebuilds the thumbnail(s) (cells whose mixed fill is transparent now show the new colour)

== alternative path: hex field in the Frame panel ==
User -> FP : edit hex text of the Background row and press Enter (or leave the field)
alt text is a valid #RRGGBB
  FP -> S : set_frame_background(selected frame id, rgb, false)
else invalid
  FP -> FP : revert the text to the current colour
end

== undo ==
User -> S : Ctrl+Z
S -> H : undo(project)
H -> F : revert(): frame.set_background(before)  (and select the affected frame for single-frame commands)
@enduml

@startuml 15c_seq_layer_operations
!include _style.puml
title Sequence - Layer operations on the selected frame (add, duplicate, delete, reorder, select, rename, visibility, opacity)
autonumber

actor User
participant "LayerPanel" as LP
participant "EditorSession" as S
participant "Command\n(AddLayer / DeleteLayer /\nMoveLayer / SetLayerProps)" as C
participant "History" as H
participant "Frame\n(selected frame)" as F
participant "CanvasRenderer /\nThumbnailCache" as R

alt User clicks [+ Add]
  User -> LP : click Add
  LP -> S : add_layer()
  alt the frame already has 64 layers
    S --> LP : status bar "Layer limit (64) reached", nothing happens   (the button is disabled at 64)
  else
    S -> C : AddLayerCommand::blank_above(project, frame_id)\n(Layer::blank(frame.alloc_layer_id(), "Layer <id>"), index = active + 1)
    S -> H : execute(cmd, project)
    H -> C : apply(project)
    C -> F : insert_layer(index, layer); select_layer(index)   (the new layer becomes the active one)
  end
else User clicks [Duplicate]
  User -> LP : click Duplicate
  LP -> S : duplicate_layer()
  S -> C : AddLayerCommand::duplicate(project, frame_id, active index)\n(copy of both planes, fresh LayerId, name "<name> copy", index = active + 1)
  S -> H : execute(cmd, project)
else User clicks [Delete]  (disabled when the frame has one layer)
  User -> LP : click Delete
  LP -> S : delete_layer()
  S -> C : DeleteLayerCommand::new(project, frame_id, active index)   (keeps the whole layer for undo)
  S -> H : execute(cmd, project)
  H -> C : apply(project)
  C -> F : remove_layer(index); select_layer(min(index, len - 1))
else User drags layer row r and drops it on slot s
  User -> LP : drag row r  (LayerDrag{ from: r, hover_slot })
  LP -> LP : draws an insertion line at hover_slot while dragging
  User -> LP : release
  opt the position changed
    LP -> S : move_layer(from, to)   (rows converted to layer indices: index = len - 1 - row)
    S -> C : MoveLayerCommand{ frame_id, from, to, active_before }
    S -> H : execute(cmd, project)
    H -> C : apply(project)
    C -> F : move_layer(from, to); select_layer(to)
  end
else User clicks a layer row
  User -> LP : click row
  LP -> S : select_layer(i)
  S -> F : select_layer(i)   (not undoable, not dirty-making; the selection mask is kept)
else User clicks the eye, commits a rename, or releases the opacity slider
  User -> LP : toggle eye / Enter or focus lost in the name field / slider released
  LP -> S : set_layer_props(layer_id, LayerProps{ name, visible, opacity })
  S -> C : SetLayerPropsCommand::new(project, frame_id, layer_id, after)   (None when nothing differs: nothing recorded)
  S -> H : execute(cmd, project)
  H -> C : apply(project)
  C -> F : set_layer_props(layer_id, after)
end

... next egui frame ...
R -> F : revision() changed -> re-run Compositor::flatten(frame) and redraw the canvas
R -> R : hidden layers are skipped by the Compositor: they vanish from the canvas, the thumbnails AND every export
R -> R : ThumbnailCache rebuilds the thumbnail of this frame

note over S
  Every layer command stops playback first and is one undo step. Layer commands never touch the selection mask.
  Tools only ever write into the ACTIVE layer, and refuse a hidden active layer.
end note
@enduml
