@startuml 12a_seq_create_project
!include _style.puml
title Sequence - Create new project (Welcome screen -> Editor)
autonumber

actor User
participant "WelcomeScreen" as W
participant "AsciiPaintApp" as App
participant "NewProjectModal" as M
participant "FileDialogs" as FD
participant "Clock" as Clk
participant "Project" as P
participant "ProjectRepository" as Repo
participant "AsprCodec +\nAtomicWriter" as Disk
participant "RecentStore" as Recent
participant "EditorScreen" as Ed

User -> W : click "Create new project"
W --> App : AppAction::OpenNewProjectModal  (returned from ui())
App -> M : new(name = "Untitled", folder = <Documents>/AsciiPaint, background = #000000, fps = 12, canvas = 240x72 8x15)
App -> App : modal = Some(Modal::NewProject(M))

loop every egui frame while the modal is open
  User -> M : edit name / background / fps
  M -> M : validate() -> enables or disables [Create]\nand shows the first error under the offending field
  opt User clicks "Browse..."
    User -> M : click Browse
    M -> FD : pick_folder(start = folder)
    FD --> M : Option<PathBuf>   (None = user cancelled -> folder unchanged)
  end
end

alt User clicks Cancel or presses Esc
  M --> App : ModalOutcome::Cancelled
  App -> App : modal = None   (screen stays Welcome)
else User clicks Create [form valid]
  User -> M : click Create
  M -> M : validate() -> NewProjectParams{ name (trimmed), folder, background, fps }
  M --> App : ModalOutcome::Accepted(AppAction::CreateProject(params))
  App -> Clk : now_unix()
  Clk --> App : now
  App -> P : Project::new(name, background, fps, now)
  P --> App : project   (1 blank frame holding 1 blank layer, selected = 0, history will start clean)
  App -> App : path = folder / (name + ".aspr")
  App -> Repo : save(path, &project)
  Repo -> Disk : AsprCodec.encode(project) then AtomicWriter::write(path, bytes)
  alt write fails (permissions, disk full, folder removed)
    Disk --> Repo : Err(io)
    Repo --> App : Err(RepoError::Io)
    App -> M : error = Some(readable message)   (modal stays open, nothing else changed)
  else write ok
    Disk --> Repo : Ok
    Repo --> App : Ok
    App -> Recent : touch(path, name, now)
    App -> Ed : EditorScreen::new(project, path, glyphs, Services.brushes.library().clone(), Services.clipboard.clone())
    note right of Ed
      EditorSession defaults: tool = Paint, brush = '#', planes = {Foreground}, ink = opaque white, fill = opaque #808080,
      erase size = 1, active layer = "Layer 1" of frame 1, show_grid = true, history = new (clean), selection = empty,
      playback = Stopped, viewport.needs_fit = true -> CanvasView calls viewport.fit() on its first paint,
      when the real widget size is known.
    end note
    App -> App : screen = AppScreen::Editor(Ed); modal = None
  end
end
@enduml

@startuml 12b_seq_open_recent
!include _style.puml
title Sequence - Open recent project
autonumber

actor User
participant "WelcomeScreen" as W
participant "AsciiPaintApp" as App
participant "RecentStore" as Recent
participant "RecentProjectsModal" as M
participant "FileDialogs" as FD
participant "ProjectRepository" as Repo
participant "EditorScreen" as Ed
participant "ErrorModal" as Err

User -> W : click "Open recent"
W --> App : AppAction::OpenRecentModal
App -> Recent : entries()
Recent --> App : &[RecentEntry]  (max 10, newest first)
loop for each entry
  App -> App : exists = Path::exists(entry.path)
end
App -> M : new(rows = [RecentRow{ entry, exists }])
App -> App : modal = Some(Modal::RecentProjects(M))

alt rows is empty
  M -> M : shows "No recent projects yet" and only [Browse...] [Close]
end

loop until the modal is closed
  alt User clicks a row
    User -> M : click row  ->  selected = Some(i)
  else User clicks "Remove from list" [row selected]
    M --> App : Accepted(AppAction::RemoveRecent(path))
    App -> Recent : remove(path)
    App -> M : rebuild rows (modal stays open)
  else User clicks "Clear list"
    M --> App : Accepted(AppAction::ClearRecent)
    App -> Recent : clear()
  else User clicks "Browse..."
    M -> FD : pick_file(filter = ["aspr"])
    FD --> M : Option<PathBuf>
    M --> App : Accepted(AppAction::OpenProjectFile(path))  [only when Some]
  else User double-clicks a row, or selects a row and clicks "Open"
    note over M : [Open] is disabled for rows with exists == false\n(row is greyed and labelled "missing")
    M --> App : Accepted(AppAction::OpenProjectFile(entry.path))
  end
end

== handling OpenProjectFile(path) ==
alt current screen is Editor and history.is_dirty()
  App -> App : pending = OpenProjectFile(path); modal = ConfirmUnsaved   (flow continues as in diagram 09a)
else
  App -> Repo : load(path)
  alt Ok(project)
    Repo --> App : project
    App -> Recent : touch(path, project.meta.name, now)
    App -> Ed : EditorScreen::new(project, path, glyphs, brush library, clipboard)
    App -> App : screen = Editor(Ed); modal = None
  else Err(RepoError::NotFound)
    Repo --> App : NotFound
    App -> Err : new("Project not found", "The file no longer exists:\n<path>")
    App -> App : modal = Some(Modal::Error(Err))   (entry stays in the list, shown as missing next time)
  else Err(RepoError::Format(e)) or Err(RepoError::Io(e))
    Repo --> App : error
    App -> Err : new("Cannot open project", message(e))
    App -> App : modal = Some(Modal::Error(Err))
  end
end

note over App
  message(e) mapping (user-facing text)
  BadMagic -> "This file is not an AsciiPaint project."
  UnsupportedVersion(v) -> "This project was saved by a newer version of the app (file format {v})."
  Truncated | LengthMismatch | CrcMismatch | Compression -> "The file is damaged and cannot be read."
  InvalidField(name, why) -> "The file contains invalid data: {name} ({why})."
  ReservedFlags -> "The file uses features this version does not support."
  Io(e) -> the OS error text.
end note
@enduml
