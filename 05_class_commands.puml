@startuml 05_class_commands
!include _style.puml
title Undo / redo - Command pattern - crate ascii_core::history

package "ascii_core::history" {

  interface Command <<trait>> {
    + label() -> &str
    + apply(project: &mut Project)
    + revert(project: &mut Project)
  }

  class History <<struct>> {
    - undo_stack: Vec<HistoryEntry>
    - redo_stack: Vec<HistoryEntry>
    - limit: usize = 200
    - clean_marker: Option<usize>
    + new() -> History
    + execute(cmd: Box<dyn Command>, project: &mut Project)
    + execute_with_selection(cmd: Box<dyn Command>, project: &mut Project, sel: SelectionChange)
    + record_applied(cmd: Box<dyn Command>)
    + record_applied_with_selection(cmd: Box<dyn Command>, sel: SelectionChange)
    + undo(project: &mut Project) -> Option<UndoStep>
    + redo(project: &mut Project) -> Option<UndoStep>
    + can_undo() -> bool
    + can_redo() -> bool
    + undo_label() -> Option< &str >
    + redo_label() -> Option< &str >
    + mark_clean()
    + is_dirty() -> bool
  }

  class HistoryEntry <<struct>> {
    + cmd: Box<dyn Command>
    + selection: Option<SelectionChange>
  }

  class SelectionChange <<struct, Clone>> {
    + before: Selection
    + after: Selection
  }

  class UndoStep <<struct>> {
    + label: String
    + selection: Option<Selection>
  }

  class InkChange <<struct, Copy>> {
    + coord: CellCoord
    + before: InkCell
    + after: InkCell
  }

  class FillChange <<struct, Copy>> {
    + coord: CellCoord
    + before: Rgba
    + after: Rgba
  }

  class CellPatchCommand <<struct>> {
    + frame_id: FrameId
    + layer_id: LayerId
    + ink_changes: Vec<InkChange>
    + fill_changes: Vec<FillChange>
    + label: String
  }

  class SetFrameBackgroundCommand <<struct>> {
    + frame_id: FrameId
    + before: Rgb
    + after: Rgb
    + {static} new(project: &Project, frame_id: FrameId, after: Rgb) -> Option<SetFrameBackgroundCommand>
  }

  class AddFrameCommand <<struct>> {
    + index: usize
    + frame: Frame
    + selected_before: usize
    + {static} blank_after(project: &mut Project, index: usize) -> AddFrameCommand
    + {static} duplicate(project: &mut Project, index: usize) -> AddFrameCommand
  }

  class DeleteFrameCommand <<struct>> {
    + index: usize
    + frame: Frame
    + selected_before: usize
    + {static} new(project: &Project, index: usize) -> Result<DeleteFrameCommand, DomainError>
  }

  class MoveFrameCommand <<struct>> {
    + from: usize
    + to: usize
    + selected_before: usize
  }

  class SetPlaybackSettingsCommand <<struct>> {
    + before_fps: Fps
    + after_fps: Fps
    + before_looping: bool
    + after_looping: bool
  }

  class AddLayerCommand <<struct>> {
    + frame_id: FrameId
    + index: usize
    + layer: Layer
    + active_before: usize
    + {static} blank_above(project: &mut Project, frame_id: FrameId) -> Result<AddLayerCommand, DomainError>
    + {static} duplicate(project: &mut Project, frame_id: FrameId, index: usize) -> Result<AddLayerCommand, DomainError>
    + {static} with_layer(project: &Project, frame_id: FrameId, layer: Layer) -> Result<AddLayerCommand, DomainError>
  }

  class DeleteLayerCommand <<struct>> {
    + frame_id: FrameId
    + index: usize
    + layer: Layer
    + active_before: usize
    + {static} new(project: &Project, frame_id: FrameId, index: usize) -> Result<DeleteLayerCommand, DomainError>
  }

  class MoveLayerCommand <<struct>> {
    + frame_id: FrameId
    + from: usize
    + to: usize
    + active_before: usize
  }

  class SetLayerPropsCommand <<struct>> {
    + frame_id: FrameId
    + layer_id: LayerId
    + before: LayerProps
    + after: LayerProps
    + {static} new(project: &Project, frame_id: FrameId, layer_id: LayerId, after: LayerProps) -> Option<SetLayerPropsCommand>
  }

  class ResizeCanvasCommand <<struct>> {
    + before: CanvasSpec
    + after: CanvasSpec
    + {static} new(project: &Project, after: CanvasSpec) -> Option<ResizeCanvasCommand>
  }

  class CompositeCommand <<struct>> {
    + label: String
    + children: Vec<Box<dyn Command>>
  }
}

