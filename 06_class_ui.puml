@startuml 06a_class_app_shell
!include _style.puml
title UI (a) - application shell, screens, modals and actions - crate ascii_app

package "ascii_app::app" {

  class AsciiPaintApp <<struct, eframe::App>> {
    - screen: AppScreen
    - modal: Option<Modal>
    - services: Services
    - export_job: Option<ExportJobHandle>
    - pending: Option<PendingAction>
    + new(cc: &eframe::CreationContext) -> AsciiPaintApp
    + update(ctx: &egui::Context, frame: &mut eframe::Frame)
    - handle_action(a: AppAction)
    - poll_export_job()
    - on_close_requested() -> bool
  }

  class Services <<struct>> {
    + recent: RecentStore
    + projects: ProjectRepository
    + exporter: ExportService
    + glyphs: Arc<dyn GlyphSource>
    + dialogs: FileDialogs
    + clock: Clock
  }

  enum AppScreen <<enum>> {
    Welcome(WelcomeScreen)
    Editor(Box<EditorScreen>)
  }

  class FileDialogs <<struct, wraps rfd>> {
    + pick_folder(start: &Path) -> Option<PathBuf>
    + pick_file(extensions: &[&str]) -> Option<PathBuf>
  }

  class WelcomeScreen <<struct>> {
    + ui(ui: &mut egui::Ui) -> Vec<AppAction>
  }

  enum PendingAction <<enum>> {
    CloseProject
    QuitApplication
    OpenProjectFile(PathBuf)
  }

  enum AppAction <<enum>> {
    OpenNewProjectModal
    OpenRecentModal
    CreateProject(NewProjectParams)
    OpenProjectFile(PathBuf)
    RemoveRecent(PathBuf)
    ClearRecent
    RequestCloseProject
    OpenSaveModal
    QuickSave
    SaveAs(SaveRequest)
    OpenColorPicker(ColorPickTarget)
    ApplyColor(ColorPickTarget, Option<Rgb>, bool)
    ConfirmUnsaved(UnsavedChoice)
    CancelExport
    CloseModal
  }

  enum ColorPickTarget <<enum>> {
    PaintColor
    EraseColor
    FrameBackground(FrameId)
  }

  enum UnsavedChoice <<enum>> {
    Save
    Discard
    Cancel
  }

  class NewProjectParams <<struct>> {
    + name: String
    + folder: PathBuf
    + background: Rgb
    + fps: Fps
  }

  class SaveRequest <<struct>> {
    + format: SaveFormat
    + path: PathBuf
  }

  enum SaveFormat <<enum>> {
    ProjectAspr
    FramePng
    FrameAscii
    AnimationAanim
    AnimationMp4
    + extension() -> &str
    + scope() -> SaveScope
    + label() -> &str
  }

  enum SaveScope <<enum>> {
    Project
    CurrentFrame
    AllFrames
  }
}

package "ascii_app::modals" {

  interface ModalView <<trait>> {
    + title() -> &str
    + ui(ui: &mut egui::Ui) -> ModalOutcome
  }

  enum ModalOutcome <<enum>> {
    Open
    Cancelled
    Accepted(AppAction)
  }

  enum Modal <<enum>> {
    NewProject(NewProjectModal)
    RecentProjects(RecentProjectsModal)
    ColorPicker(ColorPickerModal)
    Save(SaveModal)
    ConfirmUnsaved(ConfirmUnsavedModal)
    ExportProgress(ExportProgressModal)
    Error(ErrorModal)
  }

  class NewProjectModal <<struct>> {
    - name: String
    - folder: PathBuf
    - background: Rgb
    - fps: Fps
    - canvas: CanvasSpec
    - error: Option<String>
    + validate() -> Result<NewProjectParams, NewProjectError>
  }

  class RecentProjectsModal <<struct>> {
    - rows: Vec<RecentRow>
    - selected: Option<usize>
  }

  class RecentRow <<struct>> {
    + entry: RecentEntry
    + exists: bool
  }

  class ColorPickerModal <<struct>> {
    - target: ColorPickTarget
    - original: Option<Rgb>
    - working: Option<Rgb>
    - allow_transparent: bool
    - apply_to_all: bool
  }

  class SaveModal <<struct>> {
    - format: SaveFormat
    - file_name: String
    - folder: PathBuf
    - ffmpeg_available: bool
    - error: Option<String>
    + validate() -> Result<SaveRequest, SaveFormError>
  }

  class ConfirmUnsavedModal <<struct>> {
    - project_name: String
  }

  class ExportProgressModal <<struct>> {
    - done: u32
    - total: u32
    - cancelling: bool
  }

  class ErrorModal <<struct>> {
    - heading: String
    - details: String
  }
}

