@startuml 06b_class_editor_screen
!include _style.puml
title UI (b) - editor screen, session and canvas - crate ascii_app::editor

package "ascii_app::editor" {

  class EditorScreen <<struct>> {
    - session: EditorSession
    - menu: MenuBar
    - tool_panel: ToolPanel
    - canvas: CanvasView
    - frame_panel: FramePanel
    - status: StatusBar
    + new(project: Project, path: PathBuf, glyphs: Arc<dyn GlyphSource>) -> EditorScreen
    + ui(ctx: &egui::Context) -> Vec<AppAction>
    + handle_shortcuts(ctx: &egui::Context) -> Vec<AppAction>
  }

  class EditorSession <<struct>> {
    + project: Project
    + path: PathBuf
    + history: History
    + selection: Selection
    + tools: ToolRegistry
    + brush: Brush
    + viewport: Viewport
    + playback: PlaybackController
    + thumbnails: ThumbnailCache
    + show_grid: bool
    + is_dirty() -> bool
    + set_tool(id: ToolId)
    + set_paint_color(c: Rgb)
    + set_erase_color(c: Option<Rgb>)
    + set_channel(ch: PaintChannel)
    + select_frame(i: usize)
    + add_frame()
    + duplicate_frame()
    + delete_frame()
    + move_frame(from: usize, to: usize)
    + set_frame_background(id: FrameId, c: Rgb, all_frames: bool)
    + set_fps(f: Fps)
    + set_looping(on: bool)
    + undo()
    + redo()
    + delete_selection_contents()
    + toggle_playback(now: Instant)
  }

  class MenuBar <<struct>> {
    + ui(ui: &mut egui::Ui, s: &mut EditorSession) -> Vec<AppAction>
  }

  class ToolPanel <<struct>> {
    + ui(ui: &mut egui::Ui, s: &mut EditorSession) -> Vec<AppAction>
  }

  class FramePanel <<struct>> {
    - drag: Option<FrameDrag>
    + ui(ui: &mut egui::Ui, s: &mut EditorSession) -> Vec<AppAction>
  }

  class FrameDrag <<struct>> {
    + from: usize
    + hover_slot: usize
  }

  class StatusBar <<struct>> {
    + ui(ui: &mut egui::Ui, s: &EditorSession, hover: Option<CellCoord>)
  }

  class CanvasView <<struct>> {
    - hover: Option<CellCoord>
    - space_pan: bool
    - renderer: CanvasRenderer
    + ui(ui: &mut egui::Ui, s: &mut EditorSession) -> Option<CellCoord>
    - translate_input(ui: &egui::Ui, s: &EditorSession) -> Vec<ToolEvent>
  }

  class CanvasRenderer <<struct>> {
    - atlas: GlyphAtlas
    - edges_cache: Option<(u64, Vec<EdgeSegment>)>
    + paint(painter: &egui::Painter, rect: egui::Rect, s: &EditorSession)
  }

  class GlyphAtlas <<struct>> {
    - texture: egui::TextureHandle
    - slots: HashMap<char, u32>
    - next_slot: u32
    + new(ctx: &egui::Context, src: Arc<dyn GlyphSource>) -> GlyphAtlas
    + uv(ch: char) -> egui::Rect
    - rebuild()
  }

  class Viewport <<struct>> {
    + zoom: f32
    + origin: egui::Vec2
    + {static} MIN_ZOOM: f32 = 0.1
    + {static} MAX_ZOOM: f32 = 16.0
    + {static} WHEEL_STEP: f32 = 1.1
    + screen_to_cell(p: egui::Pos2, canvas: &CanvasSpec) -> Option<CellCoord>
    + screen_to_cell_clamped(p: egui::Pos2, canvas: &CanvasSpec) -> CellCoord
    + cell_rect(c: CellCoord, canvas: &CanvasSpec) -> egui::Rect
    + visible_cells(view: egui::Rect, canvas: &CanvasSpec) -> CellRect
    + zoom_at(cursor: egui::Pos2, notches: f32)
    + zoom_step(direction: i32, view: egui::Rect)
    + pan_by(delta: egui::Vec2, view: egui::Rect, canvas: &CanvasSpec)
    + fit(view: egui::Rect, canvas: &CanvasSpec)
    + actual_size(view: egui::Rect, canvas: &CanvasSpec)
  }

  class PlaybackController <<struct>> {
    - state: PlaybackState
    - last_advance: Option<Instant>
    + state() -> PlaybackState
    + play(now: Instant)
    + pause()
    + tick(now: Instant, tl: &mut Timeline) -> Option<Duration>
  }

  enum PlaybackState <<enum>> {
    Stopped
    Playing
  }

  class ThumbnailCache <<struct>> {
    - entries: HashMap<FrameId, ThumbEntry>
    + get(ctx: &egui::Context, f: &Frame) -> &egui::TextureHandle
    + retain_only(ids: &[FrameId])
  }

  class ThumbEntry <<struct>> {
    + revision: u64
    + texture: egui::TextureHandle
  }
}

